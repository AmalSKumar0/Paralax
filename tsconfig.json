{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@api/*": ["api/*"],
      "@shared/*": ["api/shared/*"]
    }
  },
  "include": ["api/**/*", "scripts/**/*", "tools/**/*", "tests/**/*"],
  "exclude": ["node_modules", "frontend", "dist", ".venv"]
}

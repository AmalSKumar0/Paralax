# ======================================================================
# Paralax Backend Environment Configuration (.env)
# ======================================================================

# Groq API Key for free tier high-speed STT (Whisper) & Translation (LLaMA 3.3)
# Sign up and generate your free API key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# AI Provider to use:
#   'groq' - Free tier: Groq Whisper STT + Groq LLaMA Translation + Edge-TTS voice
#   'mock' - Offline zero-key local simulation (with Edge-TTS voice synthesis)
#   'aws'  - Amazon Transcribe Streaming + Amazon Translate + Amazon Polly
AI_PROVIDER=groq

# Local Server Settings
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origin (use http://localhost:5173 for Vite frontend or * for all)
CORS_ALLOW_ORIGIN=*

# AWS Deployment & Region Settings (used when deploying or running in AWS mode)
AWS_REGION=us-east-1
ENVIRONMENT=dev

# Audio Storage & Limits
MAX_UTTERANCE_SEC=15
STORE_AUDIO=true

# ======================================================================
# Paralax Unified Vercel Project Environment Configuration (.env)
# ======================================================================

# --- AI Providers & API Keys ---
# Groq (Free Tier): https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# xAI Grok (Optional Paid Fallback): https://console.x.ai
XAI_API_KEY=

# Ordered Fallback Chains (comma-separated):
STT_PROVIDERS=groq,xai
TRANSLATE_PROVIDERS=groq,xai
TTS_PROVIDERS=edge,xai

# Paid Fallback Guardrail:
# Set to 'false' to guarantee $0.00 zero-cost (xAI is skipped). Set to 'true' only if you wish to pay for xAI fallback.
ALLOW_PAID_FALLBACK=false

# Model Overrides (defaults to current recommended models):
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_LLAMA_MODEL=llama-3.3-70b-versatile
XAI_CHAT_MODEL=grok-2-latest

# --- Database & Storage (Vercel Marketplace Free Tiers) ---
# Upstash Redis (Hot State): from Vercel Marketplace Upstash integration or https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Neon Postgres (Jobs & Conversation History): from Vercel Marketplace Neon integration or https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Vercel Blob (Audio Persistence - only needed if store_audio=true):
BLOB_READ_WRITE_TOKEN=

# --- Admin Authentication (JWT Cookie + Bcrypt) ---
# Default Admin Email:
ADMIN_EMAIL=admin@paralax.io

# Admin Password Hash (bcryptjs format):
# Generate with: npm run hash-password <your_password>
# Default below corresponds to password: "AdminPassword123!"
ADMIN_PASSWORD_HASH=$2a$10$wE.D5R9xLw5e7Z1hB8J6h.5K5HhT9s7vL2bM1nX3qP8vL4aO5rF2i

# Secret key for HS256 JWT cookie signing:
JWT_SECRET=your_jwt_secret_at_least_32_characters_long_random_string

# Secret token for Vercel Cron retention cleanup verification:
CRON_SECRET=your_random_cron_secret_string

# --- System Defaults ---
PORT=3000
NODE_ENV=development

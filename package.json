{
  "name": "paralax",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "build": "cd frontend && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && cd frontend && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx api/db/migrate.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "registry:check": "tsx scripts/check-registry.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.18.4",
    "@neondatabase/serverless": "^0.10.4",
    "@upstash/redis": "^1.34.4",
    "@vercel/functions": "^2.1.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.2",
    "jose": "^5.9.6",
    "mpg123-decoder": "^1.0.3",
    "msedge-tts": "^2.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.8",
    "drizzle-kit": "^0.30.5",
    "msw": "^2.7.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }

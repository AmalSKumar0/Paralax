# API Base URL for Paralax Backend (local development server or deployed AWS API Gateway)
# Examples:
#   Local Server:       http://localhost:8000/v1
#   Deployed AWS Stack: https://a1b2c3d4e5.execute-api.us-east-1.amazonaws.com/v1
VITE_API_BASE_URL="http://localhost:8000/v1"

# AWS Cognito Configuration for Authentication (optional for local server, required for deployed AWS)
VITE_COGNITO_REGION="us-east-1"
VITE_COGNITO_USER_POOL_ID=""
VITE_COGNITO_CLIENT_ID=""

# Mock Mode:
# Set to 'false' to connect to the real backend API (local server or AWS).
# Set to 'true' only if you want offline in-browser mock simulation.
VITE_MOCK_MODE="false"

# Enable Streaming Sessions tab (default false)
VITE_ENABLE_STREAMING="false"

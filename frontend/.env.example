# API Base URL for Paralax Backend
# In the unified Vercel project, the frontend and API share the same origin, so '/api/v1' routes directly.
# For standalone local dev (e.g. running Vite without Vercel CLI), you can point to 'http://localhost:3000/api/v1'.
VITE_API_BASE_URL="/api/v1"

# Mock Mode:
# Set to 'false' to communicate with the real Node.js / Vercel backend.
# Set to 'true' only if you want offline in-browser mock simulation.
VITE_MOCK_MODE="false"

# Enable Streaming Sessions tab (default false)
VITE_ENABLE_STREAMING="false"

# API Base URL for paralax cloud backend (e.g., https://api.paralax.io/v1 or http://localhost:3000/v1)
VITE_API_BASE_URL="http://localhost:3000/v1"

# AWS Cognito Configuration for Authentication
VITE_COGNITO_REGION="us-east-1"
VITE_COGNITO_USER_POOL_ID="us-east-1_example123"
VITE_COGNITO_CLIENT_ID="exampleclientid123456789"

# Mock Mode: when 'true', enables in-browser rich IoT simulation without needing a live backend
VITE_MOCK_MODE="true"

# Enable Streaming Sessions tab (default false)
VITE_ENABLE_STREAMING="false"
